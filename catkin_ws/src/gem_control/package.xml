<?xml version="1.0"?>
<package format="3">
  <name>gem_control</name>
  <version>0.1.0</version>
  <description>Shared reference-path and path-tracking control tools for the GEM vehicle.</description>

  <maintainer email="plenarbence9417@gmail.com">Bence Plenar</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
