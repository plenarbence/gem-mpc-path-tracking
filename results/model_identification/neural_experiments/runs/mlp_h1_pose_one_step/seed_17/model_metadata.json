{
  "candidate_name": "mlp_h1_pose_one_step",
  "architecture": "mlp",
  "objective": "pose_one_step",
  "history_depth": 1,
  "feature_order": [
    "speed_k",
    "yaw_rate_k",
    "speed_command_k",
    "steering_command_k",
    "speed_k-1",
    "yaw_rate_k-1",
    "speed_command_k-1",
    "steering_command_k-1"
  ],
  "outputs": [
    "delta_speed",
    "delta_yaw_rate"
  ],
  "hidden_width": 32,
  "hidden_layers": 2,
  "activation": "tanh",
  "training": {
    "learning_rate": 0.001,
    "batch_size": 128,
    "max_epochs": 150,
    "early_stopping_patience": 20,
    "weight_decay": 1e-05,
    "gradient_clip_norm": 1.0,
    "minimum_relative_improvement": 1e-05
  },
  "scalers_file": "scalers.json"
}
